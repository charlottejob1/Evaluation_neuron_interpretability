# =============================================================================
# Evaluation_neuron_interpretability — safe for: git add .
#
# Tracks: Python/notebooks, requirements, README, small metric summaries.
# Ignores: environments, datasets, model weights, arrays, large sweep CSVs,
#          and full regenerated output trees (plots_*, runs/, smoke tests, …).
#
# GitHub hard limit: 100 MB per file.
# One-time cleanup if large files were committed before this file:
#   git rm -r --cached plots_trial_v7_exp/ pbmc_data/ 2>/dev/null; git add .
# =============================================================================

# --- Virtual environments (never commit) ---
.venv/
venv/
venv_*/
env/
ENV/
.conda/
venv_evaluation_interpretability/

# --- Python / Jupyter ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Upstream VEGA (clone locally; see README) ---
# Ignore entire cloned tree; only PLACEHOLDER is tracked on GitHub.
vega/**
!vega/PLACEHOLDER

# =============================================================================
# Binary / heavy data (global — any path)
# =============================================================================
*.h5
*.h5ad
*.npy
*.npz
*.pt
*.pth
*.pkl
*.pickle
*.parquet
*.feather
*.arrow
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# --- Raw datasets (download locally) ---
pbmc_data/
datasets/

# --- Run logs ---
*.log
sweep.log

# =============================================================================
# Neuron-simulation sweep outputs (regenerate with test_*_simulation.py)
# Entire plot folders — PNGs/CSVs reproduced from scripts.
# =============================================================================
plots_*/
plots_plots_*/

# Large sweep CSVs (any folder; gitignore cannot filter by size)
**/probabilities_overlap_threshold_sweep.csv
**/probabilities_K_sweep.csv
**/probabilities_M_sweep.csv
**/probabilities_overlap_sweep.csv
**/probabilities_beta_sweep.csv
**/overlap_regime_pairwise_values.csv

# =============================================================================
# Neuron metrics study — keep Python runners; ignore generated run outputs
# =============================================================================
neuron_metrics_study/runs/
neuron_metrics_study/**/outputs/

# =============================================================================
# VEGA training / interpretability outputs
# =============================================================================
results_vega_pbmc*/
results_*/
vega_sparse_test/
vega_sparse_test_*/
plots_vega_simulation/

# Heavy VEGA sweep artifacts (keep small CSV/JSON summaries under fcn_*/ if present)
vega_fcn_sweep/shared_mig_enrichment/
vega_fcn_sweep/sweep.log
vega_fcn_sweep/overlap_analysis/
vega_fcn_sweep/*/mig_metrics/
vega_fcn_sweep/*/mig_metrics_*/
vega_fcn_sweep/mig_aggregate/

# Optional: ignore all fcn training plots (regenerate from train_vega_pbmc)
vega_fcn_sweep/fcn_*/0*.png

# =============================================================================
# Misc generated / local-only
# =============================================================================
data_trial_v6/*.npy
**/shared_mig_enrichment/

# Cursor / IDE (optional)
.cursor/

# =============================================================================
# Kept intentionally (NOT ignored) — examples:
#   *.py, *.ipynb, requirements*.txt, README.md, create_vega_env.sh
#   vega_fcn_sweep/aggregate/per_neuron_metrics.csv (~2 MB)
#   vega_fcn_sweep/fcn_*/interpretability_metrics.csv
#   vega_fcn_sweep/fcn_*/metrics.json, training_info.txt
#   data_trial_v6/concept_mapping.json
# =============================================================================
